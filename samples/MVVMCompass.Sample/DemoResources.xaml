<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:nav="clr-namespace:MVVMCompass;assembly=MVVMCompass"
                    x:Class="MVVMCompass.Sample.DemoResources">
    <Color x:Key="Ink">#102A43</Color>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ink}" /></Style>
    <Style TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="#165DCA" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <DataTemplate x:Key="SelectedDestination" x:DataType="nav:NavigationItemContext">
        <Border Background="#165DCA" StrokeThickness="0" Padding="14,10" MinimumHeightRequest="44">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="18" Color="White" />
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="UnselectedDestination" x:DataType="nav:NavigationItemContext">
        <Border Background="Transparent" StrokeThickness="0" Padding="14,10" MinimumHeightRequest="44">
            <Label Text="{Binding Title}" VerticalTextAlignment="Center" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
